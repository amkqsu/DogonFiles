{
  "appId": "lol.dogon.files",
  "appName": "DogonFiles",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#08090b"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "backgroundColor": "#08090b",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
